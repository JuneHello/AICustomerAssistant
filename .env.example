# =========================
# DeepSeek LLM Configuration
# =========================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =========================
# MySQL (Read-Only, E-Commerce)
# =========================
MYSQL_DSN=mysql+aiomysql://readonly:password@localhost:3306/ecommerce

# =========================
# PostgreSQL (Primary Store)
# =========================
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_assistant

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379/0

# =========================
# JWT Authentication
# =========================
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# =========================
# Langfuse Observability
# =========================
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=http://localhost:3000

# =========================
# Application Settings
# =========================
APP_ENV=development
LOG_LEVEL=INFO

# =========================
# Agent / RAG Tuning
# =========================
SESSION_TOKEN_BUDGET=4096
MAX_TOOL_ITERATIONS=10
RAG_TOP_K=20
RAG_RERANKER_THRESHOLD=0.5
RAG_FINAL_TOP_N=5
